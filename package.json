{
  "name": "v1",
  "description": "tisbuet's new website v1",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://tisbuet.github.io/",
  "author": "Md. Tariqul Islam <tisbuet@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tisbuet/tisbuet.github.io"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "sanitize-html": "2.17.5"
  },
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "predeploy": "npm run build",
    "deploy": "gatsby build && gh-pages -d public -b main -t"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "^3.2.2",
    "babel-plugin-styled-components": "^2.3.0",
    "gatsby": "^5.16.1",
    "gatsby-image": "^3.11.0",
    "gatsby-plugin-google-analytics": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "lodash": "^4.17.21",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-simple-maps": "^3.0.0",
    "react-transition-group": "^4.4.5",
    "scrollreveal": "^4.0.5",
    "smooth-scroll": "^16.1.3",
    "styled-components": "^5.3.11",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@upstatement/eslint-config": "^2.0.0",
    "@upstatement/prettier-config": "^1.0.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "gatsby-remark-code-titles": "^1.1.0",
    "gh-pages": "^3.2.3",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.2",
    "prettier": "^2.8.8"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
